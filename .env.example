# Vorlage. Als .env kopieren und ausfüllen. .env wird nie eingecheckt.

# Wurzel des Projekt-Drives (lokal gespiegelt oder gemountet)
DRIVE_ROOT=
# Werkzeugordner (Projektregister.csv, H2_Kernnetz_Nordwest.csv, Kennwerte)
TOOLS_DIR=

# PostGIS
POSTGIS_HOST=
POSTGIS_PORT=5432
POSTGIS_DB=
POSTGIS_USER=
POSTGIS_PASSWORD=
POSTGIS_SSLMODE=require

# QGIS-Interpreter (PyQGIS hat kein pip, Skripte laufen als Unterprozess)
# Windows Beispiel: C:\Program Files\QGIS 4.2.x\bin\python-qgis-ltr.bat (Pfad nach Installation prüfen)
# macOS Beispiel:  /Applications/QGIS-LTR.app/Contents/MacOS/python3.x (Pfad nach Installation prüfen)
QGIS_PYTHON=
QGIS_PREFIX_PATH=
PROJ_DATA=

# LLM
ANTHROPIC_API_KEY=
LLM_MODEL=

# Laufverzeichnis
RUNS_DIR=./runs

# Umgebung für config/storage.yaml: local_windows | local_mac | server
H2_ENV=local_windows
QT_QPA_PLATFORM=offscreen

# Google-API (lokal OAuth, Server Dienstkonto)
GOOGLE_OAUTH_CLIENT_FILE=
GOOGLE_SERVICE_ACCOUNT_FILE=
GDRIVE_SHARED_DRIVE_ID=
